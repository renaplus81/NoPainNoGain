{
    "name": "thelastproject",
    "dockerComposeFile": "../docker-compose.yaml",
    "service": "app",
    "workspaceFolder": "/app",
    "shutdownAction": "stopCompose",
    // 5555はprisma studio用
    "forwardPorts": [3000, 5555],
    "postCreateCommand": "pnpm install",
    "customizations": {
        "vscode":{
            "extensions":[
                "dbeaumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss"
            ]
        }
    }
}